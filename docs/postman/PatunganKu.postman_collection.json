{
  "info": {
    "name": "PatunganKu API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "groupId",
      "value": "1"
    },
    {
      "key": "groupCode",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": "1"
    },
    {
      "key": "paymentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"rahasia123\",\n  \"name\": \"Nama User\",\n  \"phone\": \"08123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"rahasia123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Buat grup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const g = pm.response.json().group;",
                  "if (g) { pm.collectionVariables.set(\"groupId\", g.id); pm.collectionVariables.set(\"groupCode\", g.code); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kos Mawar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups"
              ]
            }
          }
        },
        {
          "name": "Gabung grup",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{groupCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "join"
              ]
            }
          }
        },
        {
          "name": "Daftar grup saya",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups"
              ]
            }
          }
        },
        {
          "name": "Detail grup",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Buat transaksi (EQUAL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().transaction;",
                  "if (t) pm.collectionVariables.set(\"transactionId\", t.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Belanja bulanan\",\n  \"amount\": 100001,\n  \"mode\": \"EQUAL\",\n  \"participantIds\": [\n    1,\n    2\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Buat transaksi (CUSTOM)",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Makan malam\",\n  \"amount\": 50000,\n  \"mode\": \"CUSTOM\",\n  \"splits\": [\n    {\n      \"userId\": 1,\n      \"amount\": 30000\n    },\n    {\n      \"userId\": 2,\n      \"amount\": 20000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Daftar transaksi",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "transactions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Balances",
      "item": [
        {
          "name": "Saldo dan rekomendasi pelunasan",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
