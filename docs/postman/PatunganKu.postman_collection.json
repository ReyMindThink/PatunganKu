        },
        {
          "name": "Daftar pelunasan",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "payments"
              ]
