generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.NVarChar(255)
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())

  memberships   GroupMember[]
  groupsCreated Group[]               @relation("GroupCreator")
  paidTx        Transaction[]         @relation("TxPayer")
  splits        TransactionSplit[]
  paymentsSent  PaymentConfirmation[] @relation("PaymentSender")
  paymentsRecv  PaymentConfirmation[] @relation("PaymentReceiver")
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique @db.NVarChar(20)
  createdBy Int
  createdAt DateTime @default(now())

  creator      User                  @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members      GroupMember[]
  transactions Transaction[]
  payments     PaymentConfirmation[]
}

model GroupMember {
  id       Int      @id @default(autoincrement())
  groupId  Int
  userId   Int
  role     String   @default("MEMBER") @db.NVarChar(20)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([groupId, userId])
}

model Transaction {
  id            Int      @id @default(autoincrement())
  groupId       Int
  payerId       Int
  description   String
  amount        Int
  receiptUrl    String?
  receiptStatus String   @default("PENDING") @db.NVarChar(20)
  createdAt     DateTime @default(now())

  group  Group              @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payer  User               @relation("TxPayer", fields: [payerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  splits TransactionSplit[]
}

model TransactionSplit {
  id            Int @id @default(autoincrement())
  transactionId Int
  userId        Int
  amount        Int

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([transactionId, userId])
}

model PaymentConfirmation {
  id         Int       @id @default(autoincrement())
  groupId    Int
  senderId   Int
  receiverId Int
  amount     Int
  proofUrl   String?
  status     String    @default("PENDING") @db.NVarChar(20)
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender   User  @relation("PaymentSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver User  @relation("PaymentReceiver", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
