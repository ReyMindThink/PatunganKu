# Contoh konfigurasi PRODUCTION (VM Azure + Azure SQL). Salin ke .env di server dan
# ganti semua nilai GANTI_*. Jangan commit berkas .env yang sudah berisi nilai asli.
NODE_ENV=production
PORT=4000

# Origin frontend, pisahkan dengan koma. Tidak boleh * di production.
CORS_ORIGIN=https://GANTI-domain-frontend.example.com

# Jumlah reverse proxy di depan backend (Caddy = 1), supaya req.ip adalah IP pengguna.
TRUST_PROXY=1

# Azure SQL mewajibkan koneksi terenkripsi; server menolak start bila nilai ini salah.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Database untuk runtime aplikasi: akun aplikasi (hak baca/tulis saja, bukan sa).
DB_SERVER=GANTI-nama-server.database.windows.net
DB_PORT=1433
DB_NAME=GANTI_nama_database
DB_USER=GANTI_akun_aplikasi
DB_PASSWORD=GANTI_DENGAN_KATA_SANDI_KUAT

# Hanya untuk prisma migrate deploy (sekali per rilis): akun dengan hak DDL.
DATABASE_URL="sqlserver://GANTI-nama-server.database.windows.net:1433;database=GANTI_nama_database;user=GANTI_akun_migrasi;password=GANTI_DENGAN_KATA_SANDI_KUAT;encrypt=true;trustServerCertificate=false"

AZURE_STORAGE_CONNECTION_STRING="GANTI_connection_string_storage_account"

GEMINI_API_KEY=GANTI_DENGAN_KUNCI_GEMINI
GEMINI_MODEL=gemini-3.5-flash-lite

# Buat rahasia acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=1h

# Kunci enkripsi nomor rekening, base64 dari 32 byte (wajib di production). Buat:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_ENC_KEY=GANTI_DENGAN_KUNCI_BASE64_32_BYTE
